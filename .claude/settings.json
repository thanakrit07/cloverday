{
  "permissions": {
    "deny": [
      "Read(~/Downloads/*.pdf)",
      "Read(~/Downloads/*statement*)",
      "Read(~/Downloads/*Statement*)",
      "Read(~/Downloads/STM_*)",
      "Read(~/Downloads/wealth-prof-*.csv)",
      "Read(./statements/raw/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/sensitive.py claude"
          }
        ]
      }
    ]
  }
}
